{
  "name": "arionpay",
  "version": "1.0.0",
  "description": "Official Node.js client for ArionPay: create crypto invoices and verify webhooks. Payments go straight to your own wallet.",
  "keywords": [
    "arionpay",
    "crypto",
    "payments",
    "bitcoin",
    "usdt",
    "payment-gateway",
    "webhook",
    "invoice"
  ],
  "homepage": "https://arionpay.com/knowledge-base",
  "license": "MIT",
  "author": "ArionPay",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArionPay-Dev/arionpay-node.git"
  }
}
